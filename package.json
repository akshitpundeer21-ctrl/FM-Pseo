{
  "name": "faresmatch-aios",
  "version": "0.1.0",
  "private": true,
  "description": "FaresMatch AI OS - Programmatic SEO, AEO, GEO & AI Visibility Operating System",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:studio": "prisma studio",
    "seed": "tsx scripts/seed.ts",
    "setup": "prisma generate && prisma migrate deploy && tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx scripts/e2e-workflow.ts",
    "check:env": "tsx scripts/check-env.ts"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "clsx": "2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.33.0",
    "next": "15.5.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
