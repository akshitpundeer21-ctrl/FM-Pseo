# =============================================================================
# FaresMatch AI OS - Environment Configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# Every value below is a PLACEHOLDER. The app runs fully without any external
# key by falling back to clearly-labelled MOCK adapters (see DEMO_MODE).
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Database. SQLite by default (zero config). For Postgres later:
#   DATABASE_URL="postgresql://user:pass@localhost:5432/faresmatch"
# and change `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# --- Security ---------------------------------------------------------------
# 32-byte key, hex or base64. Used for AES-256-GCM encryption of integration
# credentials at rest. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX_KEY
# Used to sign session cookies (HMAC-SHA256). Generate the same way.
SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET
SESSION_TTL_HOURS=168

# --- Operating mode ---------------------------------------------------------
# true  -> missing integrations resolve to MOCK adapters, results are labelled MOCK.
# false -> missing integrations raise IntegrationNotConfiguredError (nothing is faked).
DEMO_MODE=true
# MANUAL | SEMI_AUTOMATIC | AUTOMATIC  (default approval posture for new projects)
DEFAULT_APPROVAL_MODE=SEMI_AUTOMATIC

# --- LLM providers ----------------------------------------------------------
# Provider used when no per-organization integration is configured.
# anthropic | openai | mock
LLM_DEFAULT_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Model routing tiers (override to change cost/quality profile).
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_BALANCED=claude-sonnet-5
LLM_MODEL_DEEP=claude-opus-5

# --- Search / SEO data providers -------------------------------------------
# Keyword + SERP data. Without a key the KeywordDataProvider falls back to the
# mock corpus in data/mock/keywords.json (labelled MOCK in the UI).
KEYWORD_PROVIDER=mock
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERP_PROVIDER_KEY=

# --- Google -----------------------------------------------------------------
# Google Search Console + GA4. Service-account JSON path or OAuth refresh token.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GSC_SITE_URL=
GA4_PROPERTY_ID=

# --- Travel data providers --------------------------------------------------
# Real flight/route/price data. Without credentials the DynamicDataEngine uses
# the static reference dataset in data/mock/ (labelled MOCK, never presented as live).
TRAVEL_DATA_PROVIDER=mock
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
DUFFEL_API_KEY=

# --- CMS / publishing -------------------------------------------------------
# local_static | webhook | wordpress
PUBLISH_ADAPTER=local_static
# local_static: directory served at /site/* by the app itself
PUBLISH_LOCAL_DIR=./published
# webhook
PUBLISH_WEBHOOK_URL=
PUBLISH_WEBHOOK_SECRET=
# wordpress
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# --- AI visibility ----------------------------------------------------------
# Which model platforms to probe for brand mentions/citations.
# Comma separated subset of: anthropic,openai,perplexity,mock
AI_VISIBILITY_PLATFORMS=mock
PERPLEXITY_API_KEY=

# --- Crawler ----------------------------------------------------------------
CRAWLER_USER_AGENT=FaresMatchAIOS/0.1 (+https://faresmatch.local/bot)
CRAWLER_MAX_PAGES=200
CRAWLER_CONCURRENCY=4
CRAWLER_TIMEOUT_MS=15000

# --- Budgets / limits -------------------------------------------------------
DEFAULT_MONTHLY_TOKEN_BUDGET=5000000
DEFAULT_MONTHLY_COST_BUDGET_USD=250
AGENT_MAX_RETRIES=2
AGENT_TIMEOUT_MS=120000
